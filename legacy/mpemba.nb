Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Sphere", " ", "embedding"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sphere", "[", 
      RowBox[{"th_", ",", "ph_"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "th", "]"}], " ", 
        RowBox[{"Cos", "[", "ph", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Sin", "[", "th", "]"}], " ", 
        RowBox[{"Sin", "[", "ph", "]"}]}], ",", 
       RowBox[{"Cos", "[", "th", "]"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Convert", " ", "a", " ", "Cartesian", " ", "unit", " ", "vector", " ", 
     "to", " ", "spherical", " ", "coords", " ", 
     RowBox[{"(", 
      RowBox[{"theta", ",", "phi"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"toSpherical", "[", 
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ArcCos", "[", "z", "]"}], ",", 
       RowBox[{"ArcTan", "[", 
        RowBox[{"x", ",", "y"}], "]"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Raw", " ", "coordinate", " ", "vectors"}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"dThetaCoord", "[", 
      RowBox[{"theta_", ",", "phi_"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", "theta", "]"}], " ", 
        RowBox[{"Cos", "[", "phi", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Cos", "[", "theta", "]"}], " ", 
        RowBox[{"Sin", "[", "phi", "]"}]}], ",", 
       RowBox[{"-", 
        RowBox[{"Sin", "[", "theta", "]"}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dPhiCoord", "[", 
      RowBox[{"theta_", ",", "phi_"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sin", "[", "theta", "]"}]}], " ", 
        RowBox[{"Sin", "[", "phi", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Sin", "[", "theta", "]"}], " ", 
        RowBox[{"Cos", "[", "phi", "]"}]}], ",", "0"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Unit", " ", "vectors", " ", 
      RowBox[{"w", ".", "r", ".", "t", ".", "rescaled"}], " ", "metric", " ", 
      
      RowBox[{"ds", "^", "2"}]}], "=", 
     RowBox[{
      RowBox[{"lambda", " ", 
       RowBox[{"dtheta", "^", "2"}]}], "+", 
      RowBox[{"Lambda", " ", 
       RowBox[{"sin", "^", "2"}], 
       RowBox[{"(", "theta", ")"}], " ", 
       RowBox[{"dphi", "^", "2"}]}]}]}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"eThetaUnit", "[", 
      RowBox[{"theta_", ",", "phi_", ",", "lambda_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"dThetaCoord", "[", 
       RowBox[{"theta", ",", "phi"}], "]"}], "/", 
      RowBox[{"Sqrt", "[", "lambda", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"ePhiUnit", "[", 
      RowBox[{"theta_", ",", "phi_", ",", "Lambda_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sin", "[", "phi", "]"}]}], ",", 
        RowBox[{"Cos", "[", "phi", "]"}], ",", "0"}], "}"}], "/", 
      RowBox[{"Sqrt", "[", "Lambda", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"The", " ", "point", " ", "on", " ", "the", " ", "beta"}], "-", 
      
      RowBox[{"parametrized", " ", "curve"}]}], ",", 
     RowBox[{"as", " ", "a", " ", "unit", " ", "vector", " ", "in", " ", 
      RowBox[{"R", "^", "3"}]}]}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"betaCurve", "[", 
      RowBox[{"b_", ",", "ep_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "b"}], "*", 
          RowBox[{"ep", "/", "2"}]}], "]"}], ",", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "b"}], "/", "2"}], "]"}]}], "}"}], "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "+", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "b"}], "*", "ep"}], "]"}], "+", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", "b"}], "]"}]}], "]"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.991965487400511*^9, 3.991965556699068*^9}, {
  3.9930982245449142`*^9, 3.9930982478795547`*^9}, {3.9930982919406767`*^9, 
  3.99309830052066*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"cca01784-f071-4624-92e6-f19bf1799337"]
}, Closed]],

