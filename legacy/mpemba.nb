         RowBox[{"ColorData", "[", "13", "]"}], "[", "2", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "1", ",", "1"}], "}"}], "/", 
            RowBox[{"Sqrt", "[", "3", "]"}]}]}], "}"}], "]"}]}], "}"}], "]"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{"(*", "AXIS", "*)"}], "\[IndentingNewLine]", 
