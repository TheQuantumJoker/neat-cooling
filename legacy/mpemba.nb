Cell[CellGroupData[{

Cell["Geodesics Solver", "Subsection",
 CellChangeTimes->{{3.991965563801651*^9, 
  3.9919655680669727`*^9}},ExpressionUUID->"120f8117-b959-46ec-b2da-\
e0d97c4a7485"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"geodesicEqs", "[", 
     RowBox[{"lambda_", ",", "Lambda_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"theta", "''"}], "[", "s", "]"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Lambda", "/", "lambda"}], ")"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"theta", "[", "s", "]"}], "]"}], " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"theta", "[", "s", "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{
           RowBox[{"phi", "'"}], "[", "s", "]"}], "^", "2"}]}]}], "==", "0"}],
       ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"phi", "''"}], "[", "s", "]"}], "+", 
        RowBox[{"2", " ", 
         RowBox[{"Cot", "[", 
          RowBox[{"theta", "[", "s", "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"theta", "'"}], "[", "s", "]"}], " ", 
         RowBox[{
          RowBox[{"phi", "'"}], "[", "s", "]"}]}]}], "==", "0"}]}], "}"}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Solve", " ", "the", " ", "boundary", " ", "value", " ", "problem", " ", 
     "between", " ", "two", " ", 
     RowBox[{"(", 
      RowBox[{"theta", ",", "phi"}], ")"}], " ", 
     RowBox[{"points", ".", "Returns"}], " ", "an", " ", "Association", " ", 
     "with", " ", "curve", " ", "points"}], ",", "endpoints", ",", 
    RowBox[{"and", " ", "length"}], ",", 
    RowBox[{"or", " ", 
     RowBox[{"Missing", "[", "\"\<NoSolution\>\"", "]"}], " ", "if", " ", 
     "the", " ", "shooting", " ", "method", " ", 
     RowBox[{"fails", "."}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"solveGeodesicTP", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"thA_", ",", "phA_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"thB_", ",", "phB_"}], "}"}], ",", "lambda_", ",", "Lambda_", 
      ",", 
      RowBox[{"nPts_", ":", "200"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "sol", ",", "thetaSol", ",", "phiSol", ",", "speedIntegrand", ",", 
        "len"}], "}"}], ",", 
      RowBox[{
       RowBox[{"sol", "=", 
        RowBox[{"Quiet", "@", 
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"geodesicEqs", "[", 
              RowBox[{"lambda", ",", "Lambda"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"theta", "[", "0", "]"}], "==", "thA"}], ",", 
               RowBox[{
                RowBox[{"phi", "[", "0", "]"}], "==", "phA"}], ",", 
               RowBox[{
                RowBox[{"theta", "[", "1", "]"}], "==", "thB"}], ",", 
               RowBox[{
                RowBox[{"phi", "[", "1", "]"}], "==", "phB"}]}], "}"}]}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"theta", ",", "phi"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"Method", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Shooting\>\"", ",", 
              RowBox[{"\"\<StartingInitialConditions\>\"", "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"theta", "[", "0", "]"}], "==", "thA"}], ",", 
                 RowBox[{
                  RowBox[{"phi", "[", "0", "]"}], "==", "phA"}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"theta", "'"}], "[", "0", "]"}], "==", 
                  RowBox[{"(", 
                   RowBox[{"thB", "-", "thA"}], ")"}]}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"phi", "'"}], "[", "0", "]"}], "==", 
                  RowBox[{"(", 
                   RowBox[{"phB", "-", "phA"}], ")"}]}]}], "}"}]}]}], 
             "}"}]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"sol", "===", 
           RowBox[{"{", "}"}]}], "||", 
          RowBox[{"FailureQ", "[", "sol", "]"}]}], ",", 
         RowBox[{"Missing", "[", "\"\<NoSolution\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{"thetaSol", "=", 
           RowBox[{"theta", "/.", " ", 
            RowBox[{"sol", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"phiSol", "=", 
           RowBox[{"phi", "/.", " ", 
            RowBox[{"sol", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"speedIntegrand", "[", "s_", "]"}], ":=", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"lambda", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"thetaSol", "'"}], "[", "s", "]"}], "^", "2"}]}], "+", 
             RowBox[{"Lambda", " ", 
              RowBox[{
               RowBox[{"Sin", "[", 
                RowBox[{"thetaSol", "[", "s", "]"}], "]"}], "^", "2"}], " ", 
              RowBox[{
               RowBox[{
                RowBox[{"phiSol", "'"}], "[", "s", "]"}], "^", "2"}]}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"len", "=", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{"speedIntegrand", "[", "s", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"s", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<curve\>\"", "->", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"sphere", "[", 
                RowBox[{
                 RowBox[{"thetaSol", "[", "s", "]"}], ",", 
                 RowBox[{"phiSol", "[", "s", "]"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"s", ",", "0", ",", "1", ",", 
                 RowBox[{"1", "/", "nPts"}]}], "}"}]}], "]"}]}], ",", 
            RowBox[{"\"\<ptA\>\"", "->", 
             RowBox[{"sphere", "[", 
              RowBox[{"thA", ",", "phA"}], "]"}]}], ",", 
            RowBox[{"\"\<ptB\>\"", "->", 
             RowBox[{"sphere", "[", 
              RowBox[{"thB", ",", "phB"}], "]"}]}], ",", 
            RowBox[{"\"\<length\>\"", "->", "len"}]}], "|>"}]}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Convenience", " ", 
    RowBox[{"wrapper", ":", 
     RowBox[{
     "solve", " ", "directly", " ", "between", " ", "two", " ", "beta", " ", 
      "values", " ", "on", " ", "the", " ", "curve"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solveGeodesicBeta", "[", 
    RowBox[{
    "bA_", ",", "bB_", ",", "ep_", ",", "lambda_", ",", "Lambda_", ",", 
     RowBox[{"nPts_", ":", "200"}]}], "]"}], ":=", 
   RowBox[{"solveGeodesicTP", "[", 
    RowBox[{
     RowBox[{"toSpherical", "[", 
      RowBox[{"betaCurve", "[", 
       RowBox[{"bA", ",", "ep"}], "]"}], "]"}], ",", 
     RowBox[{"toSpherical", "[", 
      RowBox[{"betaCurve", "[", 
       RowBox[{"bB", ",", "ep"}], "]"}], "]"}], ",", "lambda", ",", "Lambda", 
     ",", "nPts"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.991964808917498*^9, 3.9919648970048437`*^9}, 
   3.991965268490101*^9, {3.991965309165516*^9, 3.99196533804949*^9}, 
   3.991965462884797*^9, {3.991965548454296*^9, 3.991965591840601*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"dcea9cae-65f9-44f9-a32c-ce94303d1b66"]
}, Closed]],

Cell[CellGroupData[{

Cell["Graphics primitives", "Subsection",
 CellChangeTimes->{{3.991965601458559*^9, 
  3.9919656079163237`*^9}},ExpressionUUID->"85e94c57-45b1-4d11-98fb-\
429d63209a3c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Background", " ", "sphere", " ", "octant"}], "+", 
    RowBox[{"reference", " ", "beta"}], "-", "curve"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"backgroundGraphics", "[", "ep_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ParametricPlot3D", "[", 
       RowBox[{
        RowBox[{"sphere", "[", 
         RowBox[{"th", ",", "ph"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"th", ",", "0", ",", 
          RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ph", ",", "0", ",", 
          RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
        RowBox[{"Mesh", "->", "None"}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"Opacity", "[", "0.3", "]"}], ",", "LightBlue"}], "]"}]}], 
        ",", 
        RowBox[{"Boxed", "->", "False"}], ",", 
        RowBox[{"Axes", "->", "False"}]}], "]"}], ",", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"ColorData", "[", "13", "]"}], "[", "2", "]"}], ",", 
