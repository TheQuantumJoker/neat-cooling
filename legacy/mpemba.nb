Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "TRAJECTORIES", " ", "AS", " ", "A", " ", "FUNCTION", " ", "OF", " ", 
    "THE", " ", "ENERGY", " ", "DIFFERENCE"}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{
    RowBox[{"epsilons", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0.05", ",", "0.85", ",", "0.1"}], "}"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mainPlot", ",", "graphicsList", ",", " ", "legend"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"(*", "MAIN", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"graphicsList", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"backgroundGraphics", "[", "1", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"ParametricPlot3D", "[", 
            RowBox[{
             RowBox[{"betaCurve", "[", 
              RowBox[{"beta", ",", 
               RowBox[{"epsilons", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"beta", ",", "0", ",", "1000"}], "}"}], ",", 
             RowBox[{"PlotStyle", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Thickness", "[", "0.005", "]"}], ",", 
                RowBox[{
                 RowBox[{"ColorData", "[", "13", "]"}], "[", "i", "]"}]}], 
               "}"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "epsilons", "]"}]}], "}"}]}], "]"}]}], 
        "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"mainPlot", "=", 
       RowBox[{"make3DScene", "[", "graphicsList", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "LEGEND", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"legend", "=", 
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "13", "]"}], "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "epsilons", "]"}]}], "}"}]}], "]"}], ",", 
         
         RowBox[{
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"\"\<\[Epsilon]\>\"", ",", "i"}], "]"}], "->", 
              RowBox[{"epsilons", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "[", "epsilons", "]"}]}], "}"}]}], "]"}], "//", 
           RowBox[{"(", 
            RowBox[{"epsilons", "/.", " ", 
             RowBox[{
              RowBox[{"{", "}"}], "->", 
              RowBox[{"{", "}"}]}]}], ")"}]}], ";", "\[IndentingNewLine]", 
          "epsilons"}], ",", 
         RowBox[{"LegendLabel", "->", "\"\<\[Epsilon]\>\""}], ",", 
