Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"make3DScene", "[", 
    RowBox[{"graphicsList_", ",", 
     RowBox[{"viewPoint_", ":", 
      RowBox[{"{", 
       RowBox[{"3", ",", "1.", ",", "1.5"}], "}"}]}], ",", 
     RowBox[{"imgSize_", ":", "500"}]}], "]"}], ":=", 
   RowBox[{"Show", "[", 
    RowBox[{"graphicsList", ",", "\[IndentingNewLine]", 
     RowBox[{"(*", "POINTS", "*)"}], 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "Large", "]"}], ",", "Gray", ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], "]"}]}], "}"}],
       "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "Large", "]"}], ",", 
