        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "b"}], "/", "2"}], "]"}]}], "}"}], "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "+", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "b"}], "*", "ep"}], "]"}], "+", 
