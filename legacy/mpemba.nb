Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Build"}]}], " ", "the", " ", "vector"}], "-", 
     RowBox[{"field", " ", "arrow", " ", "data", " ", "on", " ", "a", " ", 
      RowBox[{"theta", "/", "phi"}], " ", 
      RowBox[{"grid", "--"}]}], "-", 
     RowBox[{
     "Returns", " ", "an", " ", "Association", " ", "with", " ", "points"}]}],
     ",", 
    RowBox[{"raw", " ", "vectors"}], ",", 
    RowBox[{
     RowBox[{"and", " ", "ready"}], "-", "to", "-", 
     RowBox[{"draw", " ", "arrow", " ", "segments", " ", 
      RowBox[{"(", 
       RowBox[{"as", " ", 
        RowBox[{"{", 
         RowBox[{"tail", ",", "head"}], "}"}], " ", "pairs"}], ")"}], " ", 
      "for", " ", "both", " ", "e_theta", " ", "and", " ", 
      RowBox[{"e_phi", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"vectorFieldData", "[", 
     RowBox[{"lambda_", ",", "Lambda_", ",", 
      RowBox[{"thetaRange_", ":", 
       RowBox[{"{", 
        RowBox[{"0.1", ",", 
         RowBox[{
          RowBox[{"Pi", "/", "2"}], "-", "0.1"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Pi", "/", "2"}], "-", "0.02"}], ")"}], "/", "10"}]}], 
        "}"}]}], ",", 
      RowBox[{"phiRange_", ":", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"Pi", "/", "2"}], ",", 
         RowBox[{"Pi", "/", "16"}]}], "}"}]}], ",", 
      RowBox[{"scale_", ":", "0.1"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "thetaVals", ",", "phiVals", ",", "points", ",", "vectorsTheta", ",", 
        "vectorsPhi", ",", "arrowDataTheta", ",", "arrowDataPhi"}], "}"}], 
      ",", 
      RowBox[{
       RowBox[{"thetaVals", "=", 
        RowBox[{"Range", "@@", "thetaRange"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"phiVals", "=", 
        RowBox[{"Range", "@@", "phiRange"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"points", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"sphere", "[", 
             RowBox[{"t", ",", "p"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "thetaVals"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"p", ",", "phiVals"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"vectorsTheta", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"eThetaUnit", "[", 
             RowBox[{"t", ",", "p", ",", "lambda"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "thetaVals"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"p", ",", "phiVals"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"vectorsPhi", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"ePhiUnit", "[", 
             RowBox[{"t", ",", "p", ",", "Lambda"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "thetaVals"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"p", ",", "phiVals"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"arrowDataTheta", "=", 
        RowBox[{"Thread", "[", 
         RowBox[{"{", 
          RowBox[{"points", ",", 
           RowBox[{"points", "+", 
            RowBox[{"scale", "*", "vectorsTheta"}]}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"arrowDataPhi", "=", 
        RowBox[{"Thread", "[", 
         RowBox[{"{", 
          RowBox[{"points", ",", 
           RowBox[{"points", "+", 
            RowBox[{"scale", "*", "vectorsPhi"}]}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<points\>\"", "->", "points"}], ",", 
         RowBox[{"\"\<vectorsTheta\>\"", "->", "vectorsTheta"}], ",", 
         RowBox[{"\"\<vectorsPhi\>\"", "->", "vectorsPhi"}], ",", 
         RowBox[{"\"\<arrowDataTheta\>\"", "->", "arrowDataTheta"}], ",", 
         RowBox[{"\"\<arrowDataPhi\>\"", "->", "arrowDataPhi"}]}], "|>"}]}]}],
      "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.991966326993917*^9, 3.9919663272656507`*^9}, {
  3.991966534073388*^9, 3.991966535502041*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"24d349d0-bc13-42e3-bde0-17a2d5a6c168"]
