Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Sphere", " ", "embedding"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sphere", "[", 
      RowBox[{"th_", ",", "ph_"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "th", "]"}], " ", 
        RowBox[{"Cos", "[", "ph", "]"}]}], ",", 
       RowBox[{"Cos", "[", "th", "]"}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sin", "[", "th", "]"}]}], " ", 
        RowBox[{"Sin", "[", "ph", "]"}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Convert", " ", "a", " ", "Cartesian", " ", "unit", " ", "vector", " ", 
     "to", " ", "spherical", " ", "coords", " ", 
     RowBox[{"(", 
      RowBox[{"theta", ",", "phi"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"toSpherical", "[", 
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ArcCos", "[", "y", "]"}], ",", 
       RowBox[{"-", 
        RowBox[{"ArcTan", "[", 
         RowBox[{"x", ",", "z"}], "]"}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Raw", " ", "coordinate", " ", "vectors"}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"dThetaCoord", "[", 
      RowBox[{"theta_", ",", "phi_"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", "phi", "]"}], " ", 
        RowBox[{"Cos", "[", "theta", "]"}]}], ",", 
       RowBox[{"-", 
        RowBox[{"Sin", "[", "theta", "]"}]}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Cos", "[", "theta", "]"}]}], " ", 
        RowBox[{"Sin", "[", "phi", "]"}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dPhiCoord", "[", 
      RowBox[{"theta_", ",", "phi_"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sin", "[", "phi", "]"}]}], " ", 
        RowBox[{"Sin", "[", "theta", "]"}]}], ",", "0", ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Cos", "[", "phi", "]"}]}], " ", 
        RowBox[{"Sin", "[", "theta", "]"}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Unit", " ", "vectors", " ", 
      RowBox[{"w", ".", "r", ".", "t", ".", "rescaled"}], " ", "metric", " ", 
      
      RowBox[{"ds", "^", "2"}]}], "=", 
     RowBox[{
      RowBox[{"lambda", " ", 
       RowBox[{"dtheta", "^", "2"}]}], "+", 
      RowBox[{"Lambda", " ", 
       RowBox[{"sin", "^", "2"}], 
       RowBox[{"(", "theta", ")"}], " ", 
       RowBox[{"dphi", "^", "2"}]}]}]}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"eThetaUnit", "[", 
      RowBox[{"theta_", ",", "phi_", ",", "lambda_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"dThetaCoord", "[", 
       RowBox[{"theta", ",", "phi"}], "]"}], "/", 
      RowBox[{"Sqrt", "[", "lambda", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"ePhiUnit", "[", 
      RowBox[{"theta_", ",", "phi_", ",", "Lambda_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sin", "[", "phi", "]"}]}], " ", 
         RowBox[{"Sin", "[", "theta", "]"}]}], ",", "0", ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Cos", "[", "phi", "]"}]}], " ", 
         RowBox[{"Sin", "[", "theta", "]"}]}]}], "}"}], "/", 
      RowBox[{"Sqrt", "[", "Lambda", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"The", " ", "point", " ", "on", " ", "the", " ", "beta"}], "-", 
      
      RowBox[{"parametrized", " ", "curve"}]}], ",", 
     RowBox[{"as", " ", "a", " ", "unit", " ", "vector", " ", "in", " ", 
      RowBox[{"R", "^", "3"}]}]}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"betaCurve", "[", 
      RowBox[{"b_", ",", "ep_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"Exp", "[", 
         RowBox[{
