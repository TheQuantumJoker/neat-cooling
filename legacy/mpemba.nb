Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"meridianGraphics", "[", 
     RowBox[{"phiSpacing_", ",", 
      RowBox[{"color_", ":", "Gray"}], ",", "opts___"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "phiVals", "}"}], ",", 
      RowBox[{
       RowBox[{"phiVals", "=", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "Pi"}], "/", "2"}], ",", "0", ",", 
          FractionBox["phiSpacing", "5"]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Graphics3D", "[", 
        RowBox[{"{", 
         RowBox[{"color", ",", "opts", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"sphere", "[", 
                RowBox[{"th", ",", "p"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"th", ",", "0", ",", 
                 RowBox[{"Pi", "/", "2"}], ",", 
                 RowBox[{
                  RowBox[{"Pi", "/", "2"}], "/", "100"}]}], "}"}]}], "]"}], 
             "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"p", ",", "phiVals"}], "}"}]}], "]"}]}], "}"}], 
        "]"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", 
      RowBox[{"Parallels", ":", 
       RowBox[{"curves", " ", "of", " ", "constant", " ", "theta"}]}]}]}], 
    ",", 
    RowBox[{
     RowBox[{"phi", " ", "running", " ", "0", " ", "to", " ", 
      RowBox[{"Pi", "/", 
       RowBox[{"2", "--"}]}]}], "-"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"parallelGraphics", "[", 
